# Copy to secrets.yaml (not committed) or add these entries to your ESPHome dashboard's secrets.yaml.
# API encryption key, generate with: openssl rand -base64 32
wordclock_api_key: "REPLACE-WITH-YOUR-OWN-KEY"
wifi_ssid: "MyWiFi"
wifi_password: "my-wifi-password"
# Password of the fallback hotspot ("<friendly name> Setup") that opens when WiFi is unreachable
wordclock_ap_password: "change-me-please"
